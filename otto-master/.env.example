# Copy to .env and fill locally. Never commit real keys.
OTTO_ASR_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
OTTO_TTS_API_KEY=replace_me
ZHIHU_ACCESS_SECRET=replace_me

# Required before exposing mutation/provisioning endpoints to a LAN.
OTTO_CONSOLE_TOKEN=replace_me
OTTO_PROVISIONING_TOKEN=replace_me

# Optional. If omitted, Otto Master creates a random local-only master credential.
OTTO_MQTT_MASTER_PASSWORD=replace_me
